# Backend API URL (used by Vite frontend)
VITE_API_BASE_URL=http://localhost:3000

# Google OAuth — Web application Client ID from Google Cloud Console
# Setup:
# 1. https://console.cloud.google.com/ → APIs & Services → Credentials
# 2. Create OAuth client ID (Web application)
# 3. Authorized JavaScript origins: http://localhost:5173, http://127.0.0.1:5173
# 4. Paste Client ID below, then restart: npm run dev
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
